# cp .env.example .env  ve doldur.  Parolalar için:  openssl rand -base64 24 | tr -d '/+='

# Neon (PostgreSQL) — Connection details → host, user, password
DB_HOST=ep-xxxxx.eu-central-1.aws.neon.tech
DB_USER=neondb_owner
DB_PASSWORD=
# Neon: SSL zorunlu; boştaki bağlantılar 30 sn sonra kapanır ki Neon uykuya geçebilsin (kota)
DB_EXTRA=;SSL Mode=Require;Trust Server Certificate=true;Timeout=30;Connection Idle Lifetime=30;Maximum Pool Size=5

# MongoDB Atlas — Connect → Drivers → connection string
MONGO_URI=mongodb+srv://KULLANICI:PAROLA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Uygulama sırları
CLIENT_SECRET=
SEED_ADMIN_PASSWORD=

# Dışarıdan erişilen adres (IP'yi tire ile yaz: 34.12.56.78 -> 34-12-56-78.sslip.io)
DOMAIN=34-12-56-78.sslip.io
PUBLIC_URL=https://34-12-56-78.sslip.io
