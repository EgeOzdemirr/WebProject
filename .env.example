# Canlı (docker-compose.prod.yml) için gerekli ayarlar.
# Kullanım:  cp .env.example .env   ->  değerleri doldur.
# Rastgele değer üretmek için:  openssl rand -base64 24

# Tüm PostgreSQL veritabanlarının parolası
POSTGRES_PASSWORD=

# WebUI <-> IdentityServer OAuth client secret'ı (hepsi için aynı)
CLIENT_SECRET=

# Seed ile oluşan 'bob' (Admin) hesabının parolası.
# Boş bırakılırsa seed rastgele bir parola üretip konsola yazar.
SEED_ADMIN_PASSWORD=

# Sitenin dışarıdan açılan adresi (CORS için), örn. http://34.12.34.56
PUBLIC_URL=http://localhost
