@model List<ResultProductWithCategoryDto>
@{
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container-fluid pt-4 pb-5">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4"><span class="bg-secondary pr-3">Favorilerim</span></h2>
    @if (Model.Count == 0)
    {
        <div class="mx-xl-5 wp-empty">
            <i class="far fa-heart"></i>
            <h5>Henüz favori ürününüz yok</h5>
            <p class="text-muted">Ürün kartlarındaki kalp simgesine tıklayarak beğendiğiniz ürünleri buraya ekleyebilirsiniz.</p>
            <a href="/ProductList/Index/" class="btn btn-primary">Ürünlere Göz At</a>
        </div>
    }
    else
    {
        <div class="row px-xl-5">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 pb-1">
                    <div class="product-item bg-light mb-4">
                        <div class="product-img position-relative overflow-hidden">
                            <a href="/ProductList/ProductDetail/@item.ProductId"><img src="@item.ProductImageUrl" alt="@item.ProductName"></a>
                        </div>
                        <div class="text-center py-4">
                            <a class="h6 text-decoration-none text-truncate" href="/ProductList/ProductDetail/@item.ProductId">@item.ProductName</a>
                            <h5 class="mt-2">₺ @item.ProductPrice.ToString("#,###.#0")</h5>
                            <div class="d-flex justify-content-center mt-3">
                                <a class="btn btn-primary btn-sm mr-2" href="/ShoppingCart/AddBasketItem/@item.ProductId"><i class="fa fa-shopping-cart mr-1"></i> Sepete Ekle</a>
                                <form method="post" action="/Wishlist/Remove/@item.ProductId" class="m-0">
                                    <button type="submit" class="btn btn-outline-dark btn-sm"><i class="fa fa-times mr-1"></i> Kaldır</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
